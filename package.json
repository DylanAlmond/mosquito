{
  "name": "mosquito",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "harness:web": "playwright test --config harness/web/playwright.config.ts",
    "harness:web:server": "cargo run -p mosquito-core --example harness_server",
    "harness:desktop": "node harness/desktop/run.mjs"
  },
  "dependencies": {
    "@fontsource/dynapuff": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.5"
  },
  "packageManager": "yarn@4.18.0"
}
